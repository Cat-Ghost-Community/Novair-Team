generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum RequestStatus {
  NEW
  REVIEWING
  ACCEPTED
  DECLINED
  CANCELLED
}

enum ProjectStatus {
  PLANNED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum TicketStatus {
  OPEN
  WAITING
  WAITING_CUSTOMER
  WAITING_SUPPORT
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
}

// Better Auth-compatible core names; application role/ownership checks remain server-side.
model User {
  id              String                 @id @default(cuid()) @db.VarChar(36)
  name            String                 @db.VarChar(100)
  email           String                 @unique @db.VarChar(191)
  emailVerified   Boolean                @default(false)
  image           String?                @db.VarChar(500)
  role            Role                   @default(USER)
  disabledAt      DateTime?              @db.DateTime(3)
  createdAt       DateTime               @default(now()) @db.DateTime(3)
  updatedAt       DateTime               @updatedAt @db.DateTime(3)
  accounts        Account[]
  sessions        Session[]
  requests        ProjectRequest[]
  ownedProjects   Project[]              @relation("ProjectOwner")
  assignments     Project[]              @relation("ProjectAssignee")
  statusChanges   ProjectStatusHistory[]
  requestStatusChanges ProjectRequestStatusHistory[]
  adminNotes      AdminNote[]
  adminOperations AdminOperation[]
  projectAuditEvents ProjectAuditEvent[]
  tickets         Ticket[]               @relation("TicketOwner")
  assignedTickets Ticket[]               @relation("TicketAssignee")
  messages        TicketMessage[]
  ticketHistory   TicketStatusHistory[]
  ticketNotes     TicketNote[]
  ticketOperations TicketOperation[]
  contentOperations ContentOperation[]
  contentAudits ContentAudit[]

  @@index([role, createdAt])
}

model Account {
  id                    String    @id @default(cuid()) @db.VarChar(36)
  accountId             String    @db.VarChar(191)
  providerId            String    @db.VarChar(64)
  userId                String    @db.VarChar(36)
  password              String?   @db.VarChar(255)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime? @db.DateTime(3)
  refreshTokenExpiresAt DateTime? @db.DateTime(3)
  scope                 String?   @db.VarChar(500)
  createdAt             DateTime  @default(now()) @db.DateTime(3)
  updatedAt             DateTime  @updatedAt @db.DateTime(3)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Session {
  id        String   @id @default(cuid()) @db.VarChar(36)
  token     String   @unique @db.VarChar(191)
  userId    String   @db.VarChar(36)
  expiresAt DateTime @db.DateTime(3)
  ipAddress String?  @db.VarChar(45)
  userAgent String?  @db.VarChar(500)
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model Verification {
  id         String   @id @default(cuid()) @db.VarChar(36)
  identifier String   @db.VarChar(191)
  value      String   @db.VarChar(255)
  expiresAt  DateTime @db.DateTime(3)
  createdAt  DateTime @default(now()) @db.DateTime(3)
  updatedAt  DateTime @updatedAt @db.DateTime(3)

  @@index([identifier])
  @@index([expiresAt])
}

model Service {
  id        String           @id @default(cuid()) @db.VarChar(36)
  slug      String           @unique @db.VarChar(100)
  title     String           @db.VarChar(150)
  summary   String           @db.VarChar(500)
  body      String           @db.Text
  category  String?          @db.VarChar(48)
  highlights Json?
  version Int @default(0)
  published Boolean          @default(false)
  sortOrder Int              @default(0)
  createdAt DateTime         @default(now()) @db.DateTime(3)
  updatedAt DateTime         @updatedAt @db.DateTime(3)
  requests  ProjectRequest[]

  @@index([published, sortOrder])
}

model ProjectRequest {
  id          String        @id @default(cuid()) @db.VarChar(36)
  ownerId     String        @db.VarChar(36)
  serviceId   String?       @db.VarChar(36)
  title       String        @db.VarChar(150)
  description String        @db.Text
  budget      Decimal?      @db.Decimal(16, 0)
  deadline    DateTime?     @db.DateTime(3)
  category    String?       @db.VarChar(48)
  budgetPreference String?  @db.VarChar(32)
  timelinePreference String? @db.VarChar(32)
  relevantUrl String?       @db.VarChar(1000)
  submissionKey String?     @db.VarChar(36)
  submissionHash String?    @db.VarChar(64)
  reviewVersion Int        @default(0)
  status      RequestStatus @default(NEW)
  createdAt   DateTime      @default(now()) @db.DateTime(3)
  updatedAt   DateTime      @updatedAt @db.DateTime(3)
  owner       User          @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  service     Service?      @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  project     Project?
  history     ProjectRequestStatusHistory[]
  adminNotes  AdminNote[]

  @@unique([ownerId, submissionKey])
  @@index([ownerId, status, createdAt, id])
  @@index([ownerId, createdAt])
  @@index([status, createdAt])
  @@index([serviceId])
}

model ProjectRequestStatusHistory {
  id         String        @id @default(cuid()) @db.VarChar(36)
  requestId  String        @db.VarChar(36)
  actorId    String        @db.VarChar(36)
  fromStatus RequestStatus?
  toStatus   RequestStatus
  publicExplanation String? @db.VarChar(2000)
  createdAt  DateTime      @default(now()) @db.DateTime(3)
  request    ProjectRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  actor      User           @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([requestId, createdAt, id])
  @@index([actorId])
}

model Project {
  id          String                 @id @default(cuid()) @db.VarChar(36)
  requestId   String?                @unique @db.VarChar(36)
  ownerId     String                 @db.VarChar(36)
  assigneeId  String?                @db.VarChar(36)
  title       String                 @db.VarChar(150)
  description String                 @db.Text
  status      ProjectStatus          @default(PLANNED)
  version     Int                    @default(0)
  plannedStart DateTime?             @db.Date
  targetCompletion DateTime?         @db.Date
  createdAt   DateTime               @default(now()) @db.DateTime(3)
  updatedAt   DateTime               @updatedAt @db.DateTime(3)
  owner       User                   @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  assignee    User?                  @relation("ProjectAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  request     ProjectRequest?        @relation(fields: [requestId], references: [id], onDelete: SetNull)
  history     ProjectStatusHistory[]
  tickets     Ticket[]
  adminNotes  AdminNote[]
  auditEvents ProjectAuditEvent[]

  @@index([ownerId, createdAt])
  @@index([assigneeId, status])
  @@index([status, updatedAt])
}

model AdminNote {
  id        String   @id @default(cuid()) @db.VarChar(36)
  requestId String?  @db.VarChar(36)
  projectId String?  @db.VarChar(36)
  authorId  String   @db.VarChar(36)
  body      String   @db.VarChar(4000)
  createdAt DateTime @default(now()) @db.DateTime(3)
  request   ProjectRequest? @relation(fields: [requestId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  author    User @relation(fields: [authorId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([requestId, createdAt, id])
  @@index([projectId, createdAt, id])
  @@index([authorId])
}

model AdminOperation {
  id           String   @id @default(cuid()) @db.VarChar(36)
  actorId      String   @db.VarChar(36)
  operationKey String   @db.VarChar(36)
  kind         String   @db.VarChar(32)
  targetId     String   @db.VarChar(36)
  payloadHash  String   @db.VarChar(64)
  result       Json
  createdAt    DateTime @default(now()) @db.DateTime(3)
  actor        User @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([actorId, operationKey])
  @@index([kind, targetId, createdAt])
}

model ProjectAuditEvent {
  id        String   @id @default(cuid()) @db.VarChar(36)
  projectId String   @db.VarChar(36)
  actorId   String   @db.VarChar(36)
  changes   Json
  createdAt DateTime @default(now()) @db.DateTime(3)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  actor     User @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([projectId, createdAt, id])
  @@index([actorId])
}

model ProjectStatusHistory {
  id         String         @id @default(cuid()) @db.VarChar(36)
  projectId  String         @db.VarChar(36)
  actorId    String         @db.VarChar(36)
  fromStatus ProjectStatus?
  toStatus   ProjectStatus
  note       String?        @db.VarChar(1000)
  createdAt  DateTime       @default(now()) @db.DateTime(3)
  project    Project        @relation(fields: [projectId], references: [id], onDelete: Restrict)
  actor      User           @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([projectId, createdAt])
  @@index([actorId])
}

model Ticket {
  id         String          @id @default(cuid()) @db.VarChar(36)
  ownerId    String          @db.VarChar(36)
  assigneeId String?         @db.VarChar(36)
  projectId  String?         @db.VarChar(36)
  subject    String          @db.VarChar(150)
  category   String          @default("GENERAL") @db.VarChar(32)
  version    Int             @default(0)
  lastActivityAt DateTime    @default(now()) @db.DateTime(3)
  messageSequence Int        @default(0)
  lastCustomerSequence Int   @default(0)
  lastSupportSequence Int    @default(0)
  customerReadSequence Int   @default(0)
  supportReadSequence Int    @default(0)
  status     TicketStatus    @default(OPEN)
  priority   TicketPriority  @default(NORMAL)
  createdAt  DateTime        @default(now()) @db.DateTime(3)
  updatedAt  DateTime        @updatedAt @db.DateTime(3)
  owner      User            @relation("TicketOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  assignee   User?           @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  project    Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  messages   TicketMessage[]
  history    TicketStatusHistory[]
  privateNotes TicketNote[]

  @@index([ownerId, status, lastActivityAt, id])
  @@index([status, lastActivityAt, id])
  @@index([ownerId, lastActivityAt, id])
  @@index([lastActivityAt, id])
  @@index([ownerId, updatedAt])
  @@index([assigneeId, status])
  @@index([status, priority, updatedAt])
  @@index([projectId])
}

model TicketMessage {
  id        String   @id @default(cuid()) @db.VarChar(36)
  ticketId  String   @db.VarChar(36)
  authorId  String   @db.VarChar(36)
  body      String   @db.Text
  authorRole Role?
  sequence   Int?
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@unique([ticketId, sequence])
  @@index([ticketId, createdAt])
  @@index([ticketId, createdAt, id])
  @@index([authorId])
}

// Separate from AdminNote so its existing exactly-one-request/project CHECK is untouched.
model TicketNote {
  id String @id @default(cuid()) @db.VarChar(36)
  ticketId String @db.VarChar(36)
  authorId String @db.VarChar(36)
  body String @db.VarChar(4000)
  createdAt DateTime @default(now()) @db.DateTime(3)
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  author User @relation(fields: [authorId], references: [id], onDelete: Restrict)
  @@index([ticketId, createdAt, id])
  @@index([authorId])
}

model TicketStatusHistory {
  id String @id @default(cuid()) @db.VarChar(36)
  ticketId String @db.VarChar(36)
  actorId String @db.VarChar(36)
  actorRole Role
  fromStatus TicketStatus?
  toStatus TicketStatus
  createdAt DateTime @default(now()) @db.DateTime(3)
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  @@index([ticketId, createdAt, id])
  @@index([actorId])
}

model TicketOperation {
  id String @id @default(cuid()) @db.VarChar(36)
  actorId String @db.VarChar(36)
  operationKey String @db.VarChar(36)
  kind String @db.VarChar(32)
  payloadHash String @db.VarChar(64)
  result Json
  createdAt DateTime @default(now()) @db.DateTime(3)
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  @@unique([actorId, operationKey])
}

model PortfolioItem {
  id          String   @id @default(cuid()) @db.VarChar(36)
  slug        String   @unique @db.VarChar(100)
  title       String   @db.VarChar(150)
  summary     String   @db.VarChar(500)
  category    String?  @db.VarChar(100)
  body        String   @db.Text
  imageKey    String?  @db.VarChar(255)
  externalUrl String?  @db.VarChar(500)
  technologies Json?
  version Int @default(0)
  published   Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now()) @db.DateTime(3)
  updatedAt   DateTime @updatedAt @db.DateTime(3)

  @@index([published, sortOrder])
}

model Faq {
  id        String   @id @default(cuid()) @db.VarChar(36)
  question  String   @db.VarChar(255)
  answer    String   @db.Text
  published Boolean  @default(false)
  sortOrder Int      @default(0)
  version Int @default(0)
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  @@index([published, sortOrder])
}

model SiteSetting {
  key       String   @id @db.VarChar(100)
  value     Json
  version Int @default(0)
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)
}

// CMS-only retry/audit records. Never reused for project or support operations.
model ContentOperation {
  id String @id @default(cuid()) @db.VarChar(36)
  actorId String @db.VarChar(36)
  operationKey String @db.VarChar(36)
  payloadHash String @db.VarChar(64)
  result Json
  createdAt DateTime @default(now()) @db.DateTime(3)
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  @@unique([actorId, operationKey])
}

model ContentAudit {
  id String @id @default(cuid()) @db.VarChar(36)
  actorId String @db.VarChar(36)
  kind String @db.VarChar(20)
  targetId String @db.VarChar(100)
  action String @db.VarChar(24)
  version Int
  createdAt DateTime @default(now()) @db.DateTime(3)
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  @@index([kind, targetId, createdAt, id])
  @@index([actorId])
}

model RateLimit {
  key         String   @id @db.VarChar(191)
  count       Int      @default(1)
  windowStart DateTime @db.DateTime(3)
  expiresAt   DateTime @db.DateTime(3)

  @@index([expiresAt])
}
