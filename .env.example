# LOCAL ONLY. Run node scripts/setup-local.mjs to create .env with random credentials.
# The setup command generates random local credentials; never commit .env.
DATABASE_URL=
MYSQL_DATABASE=novair_local
MYSQL_USER=novair
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_PORT=3307
SITE_URL=http://127.0.0.1:3000
# Local and preview builds stay out of search. See the release gates before opting in.
NOVAIR_SITE_PROFILE=local
NOVAIR_INDEX_PUBLIC=false
# Generated by local setup. Enable only with the completed authentication integration.
AUTH_ENABLED=true
BETTER_AUTH_SECRET=
# One-time bootstrap only; no administrator registration endpoint exists.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
# Public deployment remains BLOCKED; this file describes the local-only profile.
# See docs/DEPLOYMENT_READINESS.md for proposed production placeholders and required gates.
