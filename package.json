{
  "name": "novair",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "server:install": "node --experimental-strip-types scripts/install-server.mjs",
    "server:update": "node --experimental-strip-types scripts/install-server.mjs --update",
    "server:messaging": "node --experimental-strip-types scripts/install-server.mjs --messaging",
    "test:server-install": "node --test tests/unit/server-install.node.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:node",
    "test:vitest": "vitest run",
    "test:watch": "vitest",
    "test:node": "node --test --test-isolation=none tests/unit/security.node.test.mjs tests/unit/dependency-workflow.test.mjs tests/unit/requests.node.test.mjs tests/unit/management.node.test.mjs tests/unit/customer-projects.node.test.mjs tests/unit/support.node.test.mjs tests/unit/content-management.node.test.mjs tests/unit/release.node.test.mjs tests/unit/server-install.node.test.mjs tests/unit/messaging.node.test.mjs",
    "test:smoke": "playwright test",
    "test:smoke:cdp": "node --test --test-isolation=none tests/cdp/foundation.test.mjs",
    "test:http": "node --test --test-isolation=none tests/http/foundation.test.mjs",
    "db:generate": "prisma generate",
    "db:up": "docker compose --env-file .env up -d --wait mysql",
    "db:migrate": "prisma migrate deploy",
    "db:check": "node --env-file=.env --experimental-strip-types scripts/check-database.ts",
    "db:verify": "node --env-file=.env --experimental-strip-types scripts/verify-database.ts",
    "test:content-db": "node --env-file=.env --conditions=react-server --experimental-strip-types scripts/verify-public-content.ts",
    "db:init": "npm run db:generate && npm run db:migrate && npm run db:verify",
    "db:init:windows": "powershell -NoProfile -File scripts/prisma-local.ps1 -Action Generate && powershell -NoProfile -File scripts/prisma-local.ps1 -Action Migrate && npm run db:verify",
    "admin:bootstrap": "node --env-file=.env --experimental-strip-types scripts/bootstrap-admin.ts",
    "auth:inspect": "node scripts/inspect-auth-dependencies.mjs",
    "test:auth-closed": "node --test --test-isolation=none tests/http/auth-closed.test.mjs",
    "build:local": "node scripts/build-local.mjs",
    "auth:cleanup": "node --env-file=.env scripts/cleanup-auth.ts",
    "test:auth": "powershell -NoProfile -File scripts/verify-auth.ps1",
    "test:auth:browser": "powershell -NoProfile -File scripts/verify-auth.ps1 -Browser",
    "test:requests": "powershell -NoProfile -File scripts/verify-requests.ps1",
    "test:requests:browser": "powershell -NoProfile -File scripts/verify-requests.ps1 -Browser",
    "test:management": "powershell -NoProfile -File scripts/verify-management.ps1",
    "test:management:browser": "powershell -NoProfile -File scripts/verify-management.ps1 -Browser",
    "test:projects": "powershell -NoProfile -File scripts/verify-customer-projects.ps1",
    "test:projects:browser": "powershell -NoProfile -File scripts/verify-customer-projects.ps1 -Browser",
    "test:support": "powershell -NoProfile -File scripts/verify-support.ps1",
    "test:support:browser-tools": "powershell -NoProfile -File scripts/verify-support.ps1 -BrowserTools",
    "test:content": "powershell -NoProfile -File scripts/verify-content.ps1",
    "test:content:browser-tools": "powershell -NoProfile -File scripts/verify-content.ps1 -BrowserTools",
    "test:release": "powershell -NoProfile -File scripts/verify-release.ps1",
    "release:install:qualify": "powershell -NoProfile -File scripts/qualify-install.ps1",
    "release:check": "node scripts/release-readiness.mjs"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "1.7.12",
    "@prisma/client": "6.19.3",
    "@radix-ui/react-dialog": "1.1.17",
    "better-auth": "1.7.12",
    "clsx": "2.1.1",
    "lucide-react": "1.22.0",
    "next": "16.4.6",
    "nodemailer": "10.6.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
